NODE_ENV=production
VENDOR_LICENSE_PORT=3005
VENDOR_PUBLIC_URL=https://vendor.example.com
# Keep empty in this template; set a unique value via the deployment secret manager if needed.
VENDOR_LICENSE_MASTER_KEY=
VENDOR_CONSOLE_NAME=VY Group Vendor Licensing Console
VENDOR_CONSOLE_SESSION_SECRET=
# Required for first-operator setup; set a random value of at least 32 characters.
VENDOR_SETUP_TOKEN=

# Generate asymmetric keys out of band and store real values in a secret manager.
# The vendor currently needs the HRMS encryption private key for license inspection.
VENDOR_LICENSE_SIGNING_PRIVATE_KEY_B64=
VENDOR_LICENSE_SIGNING_PUBLIC_KEY_B64=
VENDOR_LICENSE_ENCRYPTION_PUBLIC_KEY_B64=
VENDOR_LICENSE_ENCRYPTION_PRIVATE_KEY_B64=

# Use dedicated, least-privilege tokens and repositories for these integrations.
CRL_GITHUB_TOKEN=
CRL_GITHUB_OWNER=VY-Groups
CRL_GITHUB_REPO=HRMS-Release-Management
CRL_GITHUB_BRANCH=main
VENDOR_GITHUB_TOKEN=
VENDOR_GITHUB_OWNER=VY-Groups
VENDOR_GITHUB_REPO=HRMS-Release-Management
VENDOR_GITHUB_BRANCH=vendor-tool
